NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Reads and writes the usage ledger that powers the free allowance.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=
# Optional. Any long random string, mixed into the hashed IP used for the
# anonymous daily ceiling.
USAGE_SALT=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true once billing is live. Until then there is no monthly cap and
# history plus occasion tips are open to everyone signed in.
ENFORCE_PRO=false
